# VidaCare Google Apps Script API Web App URL
# Obtain this URL after deploying the backend via Google Apps Script (Deploy > New deployment > Web app)
# Example: https://script.google.com/macros/s/AKfycby.../exec
VITE_APPS_SCRIPT_URL=""

# Optional API Mode: "live" (calls Apps Script Web App) or "demo" (uses client-side simulation if offline/unconfigured)
VITE_API_MODE="live"
